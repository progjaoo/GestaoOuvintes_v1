NODE_ENV=development
HOST=0.0.0.0
PORT=3010
DATABASE_URL=postgresql://radio88_user:radio88_dev_password@localhost:5434/radio88_cadastros
DATABASE_SSL=false
DATABASE_POOL_MAX=10
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres
JWT_EXPIRES_IN=2h
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:5174,http://localhost:8082,http://127.0.0.1:8082
REGISTRATION_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_PER_MINUTE=5
IP_HASH_SECRET=troque-por-outro-segredo-forte
PHONE_HASH_SECRET=troque-por-um-segredo-de-telefone-forte
DEVICE_TOKEN_SECRET=troque-por-um-segredo-de-device-com-no-minimo-32-caracteres
EXPORT_MAX_ROWS=50000
ADMIN_INITIAL_NAME=Administrador Radio 88
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=troque-esta-senha
CAMPAIGN_SLUG=lancamento-institucional-2026
CAMPAIGN_NAME=Lancamento do Site Institucional - 1 de Agosto
CAMPAIGN_STARTS_AT=2026-07-01T00:00:00-03:00
CAMPAIGN_ENDS_AT=2026-08-31T23:59:59-03:00
PRIVACY_NOTICE_VERSION=2026-08-01
PRIVACY_NOTICE_URL=/privacidade

# Banners institucionais no Cloudflare R2 (somente a API recebe secrets)
MEDIA_STORAGE_DRIVER=disabled
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=site-institucional
R2_PUBLIC_BASE_URL=
R2_OBJECT_PREFIX=banners-institucional
INSTITUTIONAL_BANNER_MAX_BYTES=10485760

# Multi-tenancy: manter desligado ate aplicar e validar a migration 0007.
DEFAULT_TENANT_SLUG=radio-88
PROGRAMMING_TIMEZONE=America/Sao_Paulo
TENANCY_ENABLED=false
TENANT_MEMBERSHIP_RBAC_ENABLED=false
LEGACY_ADMIN_RBAC_FALLBACK=true
TENANT_MEDIA_PATHS_ENABLED=false

# Clerk listener authentication (Tarefa 6). Store PEM on one line using literal \n.
CLERK_JWT_KEY=
CLERK_JWT_ISSUER=
CLERK_AUTHORIZED_PARTIES=http://localhost:8082,http://127.0.0.1:8082
CLERK_ADMIN_AUTH_ENABLED=false

# Clerk webhook lifecycle (Plano 006). Keep the signing secret only in the API.
CLERK_WEBHOOK_ENABLED=false
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_WEBHOOK_INSTANCE_KEY=development
CLERK_WEBHOOK_BODY_LIMIT_BYTES=131072

# Plano 005 - continuidade do ouvinte e CRM local
LISTENER_ACCOUNT_ENABLED=false
LISTENER_RECOVERY_HANDOFF_ENABLED=false
LISTENER_CRM_PROFILES_ENABLED=false
LISTENER_CLERK_LINK_ENABLED=false
LISTENER_APP_IDENTITY_ENABLED=false
LISTENER_RECOVERY_HANDOFF_SECRET=
LISTENER_RECOVERY_HANDOFF_TTL_MINUTES=15
LISTENER_RECOVERY_HANDOFF_MAX_PER_HOUR=3
